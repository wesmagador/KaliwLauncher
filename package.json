{
  "name": "kaliw-launcher",
  "version": "0.7.0",
  "private": true,
  "description": "KaliwLauncher \u2014 sua pr\u00f3xima dimens\u00e3o de jogo",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.cjs && node --check preload.cjs && node --check renderer.js && node --check engine-manager.cjs && node --check online-manager.cjs && node --check online-ui.js && node --check input-config.cjs && node --check input-devices.cjs && node --check controls-ui.js && node --check disc-session.cjs && node --check optical-reader.cjs && node --check session-ui.js && node --check shortcuts.js && node --check navigation-ui.js && node --check quick-menu-manager.cjs && node --check quick-preload.cjs && node --check quick-menu.js",
    "dist": "electron-builder --win portable",
    "test:engines": "node scripts/test-engines.cjs",
    "prepare:engines": "node scripts/prepare-engines.cjs && node scripts/prepare-notices.cjs && node scripts/prepare-vc-runtime.cjs",
    "test:downloads": "node scripts/test-downloads.cjs",
    "build:disc-tools": "node scripts/build-disc-tools.cjs"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.kaliw.launcher",
    "productName": "KaliwLauncher",
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "style.css",
      "renderer.js",
      "artifacts/Kaliw-boot.webm",
      "engine-manager.cjs",
      "catalog.cjs",
      "online-manager.cjs",
      "online-ui.js",
      "input-config.cjs",
      "input-devices.cjs",
      "controls-ui.js",
      "disc-session.cjs",
      "optical-reader.cjs",
      "session-ui.js",
      "shortcuts.js",
      "navigation-ui.js",
      "quick-menu-manager.cjs",
      "quick-preload.cjs",
      "quick-menu.html",
      "quick-menu.js",
      "quick-menu.css"
    ],
    "win": {
      "target": "portable"
    },
    "extraResources": [
      {
        "from": "engines",
        "to": "engines",
        "filter": [
          "retroarch.exe",
          "*.dll",
          "autoconfig/**/*",
          "info/*.info",
          "licenses/**/*",
          "manifest.json",
          "cores/swanstation_libretro.dll",
          "cores/pcee2_libretro.dll",
          "cores/kaliw_discbridge_libretro.dll",
          "kaliw-disc-reader.exe",
          "disc-tools-manifest.json"
        ]
      }
    ],
    "portable": {
      "unpackDirName": true
    }
  },
  "dependencies": {
    "koffi": "^3.3.4"
  }
}

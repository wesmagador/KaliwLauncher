{
  "name": "kaliw-launcher",
  "version": "0.10.0",
  "private": true,
  "description": "KaliwLauncher — sua próxima dimensão de jogo",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.cjs && node --check preload.cjs && node --check renderer.js && node --check engine-manager.cjs && node --check online-manager.cjs && node --check online-ui.js && node --check input-config.cjs && node --check input-devices.cjs && node --check controls-ui.js && node --check disc-session.cjs && node --check optical-reader.cjs && node --check session-ui.js && node --check shortcuts.js && node --check navigation-ui.js && node --check quick-menu-manager.cjs && node --check quick-preload.cjs && node --check quick-menu.js && node --check platforms.js && node --check accessibility-ui.js && node --check file-browser.cjs && node --check file-browser-ui.js && node --check bundled-assets.cjs && node --check modern-manager.cjs && node --check verified-archive.cjs && node --check optional-firmware.cjs && node --check firmware-ui.js && node --check compatibility-manager.cjs && node --check compatibility-ui.js && node --check mods-manager.cjs && node --check mods-ui.js && node --check logs-manager.cjs && node --check logs-ui.js && node --check arcade-manager.cjs && node --check arcade-controls.cjs",
    "dist": "electron-builder --win portable",
    "test:engines": "node scripts/test-engines.cjs",
    "prepare:engines": "node scripts/prepare-engines.cjs && node scripts/prepare-notices.cjs && node scripts/prepare-vc-runtime.cjs",
    "test:downloads": "node scripts/test-downloads.cjs",
    "build:disc-tools": "node scripts/build-disc-tools.cjs"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.kaliw.launcher",
    "productName": "KaliwLauncher",
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "style.css",
      "renderer.js",
      "artifacts/Kaliw-boot.webm",
      "engine-manager.cjs",
      "catalog.cjs",
      "online-manager.cjs",
      "online-ui.js",
      "input-config.cjs",
      "input-devices.cjs",
      "controls-ui.js",
      "disc-session.cjs",
      "optical-reader.cjs",
      "session-ui.js",
      "shortcuts.js",
      "navigation-ui.js",
      "quick-menu-manager.cjs",
      "quick-preload.cjs",
      "quick-menu.html",
      "quick-menu.js",
      "quick-menu.css",
      "platforms.js",
      "accessibility-ui.js",
      "file-browser.cjs",
      "file-browser-ui.js",
      "bundled-assets.cjs",
      "modern-manager.cjs",
      "verified-archive.cjs",
      "optional-firmware.cjs",
      "firmware-ui.js",
      "compatibility-manager.cjs",
      "compatibility-ui.js",
      "mods-manager.cjs",
      "mods-ui.js",
      "logs-manager.cjs",
      "logs-ui.js",
      "arcade-manager.cjs",
      "arcade-controls.cjs"
    ],
    "win": {
      "target": "portable"
    },
    "extraResources": [
      {
        "from": "engines",
        "to": "engines",
        "filter": [
          "retroarch.exe",
          "*.dll",
          "autoconfig/**/*",
          "info/*.info",
          "licenses/**/*",
          "manifest.json",
          "kaliw-disc-reader.exe",
          "disc-tools-manifest.json",
          "dolphin-sys.zip",
          "dolphin-assets.json",
          "multi-manifest.json",
          "multi-sources.json",
          "cores/pcee2_libretro.dll",
          "cores/swanstation_libretro.dll",
          "cores/gambatte_libretro.dll",
          "cores/mgba_libretro.dll",
          "cores/gearsystem_libretro.dll",
          "cores/fceumm_libretro.dll",
          "cores/mupen64plus_next_libretro.dll",
          "cores/stella_libretro.dll",
          "cores/mame2003_plus_libretro.dll",
          "cores/dolphin_libretro.dll",
          "cores/cemu_libretro.dll",
          "cores/kaliw_discbridge_libretro.dll",
          "modern/*.zip",
          "modern-manifest.json",
          "kaliw-engine-host.exe",
          "mame-compat-manifest.json",
          "mame2003-roms.json.gz",
          "mame0174.zip"
        ]
      },
      {
        "from": "compatibility",
        "to": "compatibility",
        "filter": [
          "catalog.json.gz"
        ]
      }
    ],
    "portable": {
      "unpackDirName": true
    }
  },
  "dependencies": {
    "koffi": "^3.3.4",
    "yauzl": "3.4.0"
  }
}
